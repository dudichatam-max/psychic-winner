{
  "schema": "e5-test-reference",
  "schemaVersion": 1,
  "testId": "rq2-cutoff-move-evidence",
  "title": "RQ2 Why cutoff move causes distortion?",
  "description": "RESEARCH: Wave=Saw or Square. START E5. Single held note; move Cutoff continuously 10–20s while listening for pops. STOP+EXPORT. Offline: windows during movement vs idle. min 1 noteOn but prefer retriggers: require >=2 control records.",
  "session": {
    "durationMs": 45000
  },
  "assertions": [
    {
      "id": "after-stop-session-off",
      "path": "e5.sessionActive",
      "operator": "equals",
      "expected": false
    },
    {
      "id": "has-exportable-data",
      "path": "e5.hasExportableData",
      "operator": "equals",
      "expected": true
    },
    {
      "id": "control-records-min",
      "path": "e5.controlRecordCount",
      "operator": "greaterThanOrEqual",
      "expected": 2
    },
    {
      "id": "audio-obs-min",
      "path": "e5.audioObservationCount",
      "operator": "greaterThanOrEqual",
      "expected": 2
    },
    {
      "id": "pending-windows-nonneg",
      "path": "e5.pendingWindowCount",
      "operator": "greaterThanOrEqual",
      "expected": 0
    },
    {
      "id": "frames-advanced",
      "path": "e5.absoluteRenderFrame",
      "operator": "greaterThan",
      "expected": 0
    },
    {
      "id": "no-control-overflow",
      "path": "e5.controlOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-window-overflow",
      "path": "e5.windowOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-audio-obs-overflow",
      "path": "e5.audioObservationOverflowCount",
      "operator": "equals",
      "expected": 0
    }
  ]
}
