{
  "schema": "e5-test-reference",
  "schemaVersion": 1,
  "testId": "bug03-wave-sine-stress",
  "title": "BUG-03 Wave Sine — high polyphony evidence",
  "description": "PROTOCOL: Wave=Sine, FX off. START E5. Reach 8 active voices if possible. STOP+EXPORT. Expect fewer artifacts than Square; still capture >=8 noteOns for comparison packs.",
  "session": {
    "durationMs": 60000
  },
  "assertions": [
    {
      "id": "after-stop-session-off",
      "path": "e5.sessionActive",
      "operator": "equals",
      "expected": false
    },
    {
      "id": "has-exportable-data",
      "path": "e5.hasExportableData",
      "operator": "equals",
      "expected": true
    },
    {
      "id": "control-records-min",
      "path": "e5.controlRecordCount",
      "operator": "greaterThanOrEqual",
      "expected": 8
    },
    {
      "id": "audio-obs-min",
      "path": "e5.audioObservationCount",
      "operator": "greaterThanOrEqual",
      "expected": 8
    },
    {
      "id": "pending-windows-nonneg",
      "path": "e5.pendingWindowCount",
      "operator": "greaterThanOrEqual",
      "expected": 0
    },
    {
      "id": "frames-advanced",
      "path": "e5.absoluteRenderFrame",
      "operator": "greaterThan",
      "expected": 0
    },
    {
      "id": "no-control-overflow",
      "path": "e5.controlOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-window-overflow",
      "path": "e5.windowOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-audio-obs-overflow",
      "path": "e5.audioObservationOverflowCount",
      "operator": "equals",
      "expected": 0
    }
  ]
}
