{
  "schema": "e5-test-reference",
  "schemaVersion": 1,
  "testId": "bug02-dividers-preset-scope-note",
  "title": "BUG-02 Dividers 2/3/4 not saved in presets",
  "description": "SCOPE NOTE: Preset persistence is NOT measurable via current E5 assertion paths. Use this ref only to capture noteOn evidence WHILE div2/div3/div4 are engaged before/after a preset save/load you do manually. START E5 → set divs → play notes → (save/load preset outside E5) → play again → STOP+EXPORT. Compare control BEFORE/AFTER snapshots offline for div fields. Assertions = session evidence only.",
  "session": {
    "durationMs": 30000
  },
  "assertions": [
    {
      "id": "after-stop-session-off",
      "path": "e5.sessionActive",
      "operator": "equals",
      "expected": false
    },
    {
      "id": "has-exportable-data",
      "path": "e5.hasExportableData",
      "operator": "equals",
      "expected": true
    },
    {
      "id": "control-records-min",
      "path": "e5.controlRecordCount",
      "operator": "greaterThanOrEqual",
      "expected": 1
    },
    {
      "id": "audio-obs-min",
      "path": "e5.audioObservationCount",
      "operator": "greaterThanOrEqual",
      "expected": 1
    },
    {
      "id": "pending-windows-nonneg",
      "path": "e5.pendingWindowCount",
      "operator": "greaterThanOrEqual",
      "expected": 0
    },
    {
      "id": "frames-advanced",
      "path": "e5.absoluteRenderFrame",
      "operator": "greaterThan",
      "expected": 0
    },
    {
      "id": "no-control-overflow",
      "path": "e5.controlOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-window-overflow",
      "path": "e5.windowOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-audio-obs-overflow",
      "path": "e5.audioObservationOverflowCount",
      "operator": "equals",
      "expected": 0
    }
  ]
}
