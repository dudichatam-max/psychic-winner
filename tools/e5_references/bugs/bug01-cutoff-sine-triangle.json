{
  "schema": "e5-test-reference",
  "schemaVersion": 1,
  "testId": "bug01-cutoff-sine-triangle",
  "title": "BUG-01 Cutoff realtime — Sine/Triangle",
  "description": "PROTOCOL (manual): Wave=Sine then Triangle. START E5. Hold a mid note, move Cutoff slowly full range; then high notes (weak/no change?); then low notes (level-like?). STOP. EXPORT diagnostics. E5 cannot assert 'cutoff audibility' — PASS means evidence captured for offline analysis of BEFORE/AFTER snapshots + PCM windows around noteOns while cutoff moved. durationMs=metadata only.",
  "session": {
    "durationMs": 45000
  },
  "assertions": [
    {
      "id": "after-stop-session-off",
      "path": "e5.sessionActive",
      "operator": "equals",
      "expected": false
    },
    {
      "id": "has-exportable-data",
      "path": "e5.hasExportableData",
      "operator": "equals",
      "expected": true
    },
    {
      "id": "control-records-min",
      "path": "e5.controlRecordCount",
      "operator": "greaterThanOrEqual",
      "expected": 2
    },
    {
      "id": "audio-obs-min",
      "path": "e5.audioObservationCount",
      "operator": "greaterThanOrEqual",
      "expected": 2
    },
    {
      "id": "pending-windows-nonneg",
      "path": "e5.pendingWindowCount",
      "operator": "greaterThanOrEqual",
      "expected": 0
    },
    {
      "id": "frames-advanced",
      "path": "e5.absoluteRenderFrame",
      "operator": "greaterThan",
      "expected": 0
    },
    {
      "id": "no-control-overflow",
      "path": "e5.controlOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-window-overflow",
      "path": "e5.windowOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-audio-obs-overflow",
      "path": "e5.audioObservationOverflowCount",
      "operator": "equals",
      "expected": 0
    }
  ]
}
