{
  "schema": "e5-test-reference",
  "schemaVersion": 1,
  "testId": "bug03-polyphony-clean-baseline",
  "title": "BUG-03 Polyphony ceiling — no Drive/Detune/FX",
  "description": "PROTOCOL: All FX off (no Drive, no Detune, no extras). START E5. Add voices 1..8 slowly. Note first distortion voice: expect ~7 for Square/Saw, Sine/Triangle cleaner toward 8. STOP+EXPORT. Require >=7 control events (7 noteOns) so evidence covers the critical range. PASS≠'no clicks'; PASS=enough linked evidence for RQ1.",
  "session": {
    "durationMs": 60000
  },
  "assertions": [
    {
      "id": "after-stop-session-off",
      "path": "e5.sessionActive",
      "operator": "equals",
      "expected": false
    },
    {
      "id": "has-exportable-data",
      "path": "e5.hasExportableData",
      "operator": "equals",
      "expected": true
    },
    {
      "id": "control-records-min",
      "path": "e5.controlRecordCount",
      "operator": "greaterThanOrEqual",
      "expected": 7
    },
    {
      "id": "audio-obs-min",
      "path": "e5.audioObservationCount",
      "operator": "greaterThanOrEqual",
      "expected": 7
    },
    {
      "id": "pending-windows-nonneg",
      "path": "e5.pendingWindowCount",
      "operator": "greaterThanOrEqual",
      "expected": 0
    },
    {
      "id": "frames-advanced",
      "path": "e5.absoluteRenderFrame",
      "operator": "greaterThan",
      "expected": 0
    },
    {
      "id": "no-control-overflow",
      "path": "e5.controlOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-window-overflow",
      "path": "e5.windowOverflowCount",
      "operator": "equals",
      "expected": 0
    },
    {
      "id": "no-audio-obs-overflow",
      "path": "e5.audioObservationOverflowCount",
      "operator": "equals",
      "expected": 0
    }
  ]
}
